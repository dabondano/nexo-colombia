# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Public address, e.g. nexo.example.org (its DNS A record must point to the server).
NEXO_DOMAIN=
# E-mail for Let's Encrypt certificate notices.
ACME_EMAIL=
# Database password: letters and digits only (it goes into a URL).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Password of the restricted account the application uses ("nexo_app"); same rules.
NEXO_APP_DB_PASSWORD=
